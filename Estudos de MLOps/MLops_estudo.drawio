        </mxCell>
        <mxCell id="l2OjA-7TtkZ2YXTV5FEY-7" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://learn.microsoft.com/en-us/azure/databricks/_static/images/machine-learning/deploy-patterns-lifecycle.png;" value="" vertex="1">
          <mxGeometry height="186" width="520" x="4233.9" y="2389" as="geometry" />
        </mxCell>
        <mxCell id="jVsKzq875xEZgueqGxEI-1" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=36;" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 36px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 700; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(248, 249, 250); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;Porque Databricks&lt;/span&gt;" vertex="1">
