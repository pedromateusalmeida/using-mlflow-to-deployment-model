        </mxCell>
        <mxCell id="Prub3Vnk3aAF926JKTRd-321" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;align=left;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Independente (Independent):&lt;/span&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Cada observação não influencia as outras&lt;/li&gt;&lt;li&gt;O valor de uma amostra não depende de outras amostras&lt;/li&gt;&lt;li&gt;Não há correlação entre as observações&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Identicamente Distribuído (Identically Distributed):&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Todas as observações vêm da mesma distribuição de probabilidade&lt;/li&gt;&lt;li&gt;Mesmos parâmetros estatísticos (média, variância, etc.)&lt;/li&gt;&lt;li&gt;Mesmo processo gerador de dados&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="660" x="6343" y="3013.65" as="geometry" />
        </mxCell>
        <mxCell id="Prub3Vnk3aAF926JKTRd-322" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;align=left;" value="&lt;div&gt;Características de um Dataset i.i.d.:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Ordem não importa - pode embaralhar sem problemas&lt;/li&gt;&lt;li&gt;&amp;nbsp;Sem dependência temporal - não há padrões sequenciais&lt;/li&gt;&lt;li&gt;Sem correlação espacial - amostras não se influenciam geograficamente&lt;/li&gt;&lt;li&gt;Distribuição estável - estatísticas não mudam ao longo do dataset&lt;/li&gt;&lt;li&gt;&amp;nbsp;Amostragem aleatória - cada ponto é uma amostra independente&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="660" x="6343" y="3243.65" as="geometry" />
        </mxCell>
